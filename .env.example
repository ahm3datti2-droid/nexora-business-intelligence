# NEXORA Business Intelligence — environment template.
# Copy to .env and fill in real values. NEVER commit a real .env file.

# PostgreSQL connection string (required at runtime; NOT required for `npm run build`)
DATABASE_URL="postgresql://user:password@host:5432/nexora_bi?sslmode=require"

# JWT signing secret for httpOnly session cookies (generate a long random string)
JWT_SECRET="change-me-to-a-long-random-secret"

# Optional: OpenAI API key for the AI Copilot (server-side only).
# If unset, the Copilot returns a calculated summary from real DB data instead.
OPENAI_API_KEY=""

# Optional: URL of the Python analytics service (FastAPI + OR-Tools) in analytics/
ANALYTICS_SERVICE_URL="http://localhost:8000"

# App URL (used for links in emails / exports)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
